<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STROM SMP - Official Server Web</title>
    <style>
        /* STORM & LIGHTNING HIGH-ENERGY VISUAL THEME */
        body {
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #060a12; /* Deep tempest dark ocean background */
            background-image: linear-gradient(135deg, #040810 0%, #0a1628 100%);
            color: #ffffff;
        }

        /* TOP NAVIGATION BAR */
        nav {
            background-color: #03060c;
            border-bottom: 2px solid #00d2ff33; 
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 20px rgba(0, 210, 255, 0.1);
        }

        .nav-logo {
            font-weight: 900;
            color: #00d2ff; /* Neon Electric Cyan */
            letter-spacing: 2px;
            font-size: 20px;
            text-shadow: 0 0 10px rgba(0, 210, 255, 0.6);
        }

        .nav-links {
            display: flex;
            gap: 25px;
            align-items: center;
        }

        .nav-links a {
            color: #7085a0;
            text-decoration: none;
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.2s ease;
        }

        .nav-links a:hover, .nav-links a.active {
            color: #00d2ff;
            text-shadow: 0 0 8px rgba(0, 210, 255, 0.4);
        }

        /* TEMPEST HERO CONTAINER */
        .hero {
            text-align: center;
            padding: 80px 20px 40px 20px;
        }

        .main-title {
            font-size: 54px;
            font-weight: 900;
            color: #ffffff;
            margin: 0 0 10px 0;
            letter-spacing: 3px;
            text-shadow: 0 0 20px rgba(0, 210, 255, 0.6);
        }

        .main-title span {
            color: #00d2ff;
        }

        .subtitle {
            color: #3b82f6; /* Electric Blue */
            font-size: 15px;
            letter-spacing: 5px;
            text-transform: uppercase;
            font-weight: 800;
            margin-bottom: 25px;
        }

        /* DATA DISPLAY CONTENT */
        .container {
            max-width: 900px;
            margin: 20px auto 60px auto;
            padding: 0 20px;
        }

        .section-title {
            color: #ffffff;
            font-size: 16px;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-weight: 800;
            margin-bottom: 20px;
            border-left: 4px solid #00d2ff;
            padding-left: 12px;
            text-align: left;
        }

        /* CONNECTION IP BLOCKS */
        .connection-row {
            background-color: #09101d;
            border: 1px solid #1e293b;
            border-radius: 6px;
            padding: 18px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
            transition: border 0.3s ease;
        }

        .connection-row:hover {
            border-color: #00d2ff55;
        }

        .connection-info {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .platform-tag {
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            padding: 5px 12px;
            border-radius: 4px;
            letter-spacing: 1px;
            min-width: 75px;
            text-align: center;
        }

        .java-tag {
            background-color: #1e3a8a;
            color: #93c5fd;
            border: 1px solid #2563eb;
        }

        .bedrock-tag {
            background-color: #065f46;
            color: #34d399;
            border: 1px solid #059669;
        }

        .ip-address {
            font-family: 'Courier New', Courier, monospace;
            font-size: 17px;
            color: #f1f5f9;
            font-weight: bold;
        }

        .copy-action {
            color: #00d2ff;
            text-transform: uppercase;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1px;
            cursor: pointer;
            background: none;
            border: none;
            transition: color 0.2s;
        }

        .copy-action:hover {
            color: #ffffff;
            text-shadow: 0 0 8px #00d2ff;
        }

        .footer-note {
            color: #4b5563;
            font-size: 12px;
            margin-top: 8px;
            margin-bottom: 50px;
            line-height: 1.4;
            text-align: left;
        }

        /* PERMANENT VISIBLE PACK DISPLAY BOX */
        .shop-box {
            background-color: #08101c;
            border: 2px solid #1d4ed8;
            border-radius: 8px;
            padding: 25px;
            margin-top: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            text-align: left;
        }

        .shop-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #1e293b;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .shop-header h3 {
            margin: 0;
            font-size: 22px;
            color: #00d2ff;
        }

        .price-badge {
            font-weight: 900; 
            color: #34d399; 
            font-size: 24px;
            text-shadow: 0 0 10px rgba(52, 211, 153, 0.2);
        }

        /* INCLUDED LOOT DETAILS GRID */
        .loot-title {
            color: #ffaa00;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 15px;
            font-weight: bold;
            text-align: left;
        }

        .loot-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 10px;
            text-align: left;
            margin-bottom: 25px;
        }

        .loot-item {
            background-color: #111a2e;
            border: 1px solid #1e293b;
            padding: 10px 14px;
            border-radius: 4px;
            font-size: 13px;
            font-weight: 600;
            color: #cbd5e1;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .loot-item span {
            color: #00d2ff;
        }

        /* DISCORD COMPONENT STYLING */
        .discord-help-box {
            background-color: #040810;
            border: 1px dashed #5865F2;
            border-radius: 6px;
            padding: 20px;
            margin-top: 25px;
            text-align: center;
        }

        .discord-btn {
            display: inline-block;
            background-color: #5865F2; /* Discord Branding Color */
            color: #ffffff;
            text-decoration: none;
            padding: 12px 24px;
            border-radius: 5px;
            font-weight: bold;
            font-size: 14px;
            margin-top: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 12px rgba(88, 101, 242, 0.3);
            transition: background-color 0.2s;
        }

        .discord-btn:hover {
            background-color: #4752C4;
        }
    </style>
</head>
